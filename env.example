# Nautilus + Alpha Agent 环境变量（复制为 .env 并填写）

# ── Alpha Agent（当前默认：Cursor MCP，见 docs/MCP_ALPHA.md）────────────────
# Legacy daemon：ALPHA_USE_DAEMON=1 时 start-stack 仍会启动 alpha_agent.py

# DeepSeek（仅 legacy alpha_agent.py 润色；MCP 方案不需要）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 飞书应用机器人（审批卡片 + 可选对话）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 群 chat_id 或用户 open_id
FEISHU_RECEIVE_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
# 事件订阅 Verification Token（与飞书后台一致）
FEISHU_VERIFICATION_TOKEN=
# 可选：Encrypt Key（启用消息加密时填写）
# FEISHU_ENCRYPT_KEY=

# 飞书 ↔ Cursor Agent 对话（gateway/）
FEISHU_AGENT_ENABLED=true
# 仅允许这些 open_id 使用机器人（逗号分隔，留空=不限制）
# FEISHU_AGENT_ALLOWED_OPEN_IDS=
# Cursor Agent CLI（默认自动探测 ~/.local/bin/cursor-agent）
# CURSOR_AGENT_PATH=/Users/you/.local/bin/cursor-agent
# 登录：cursor-agent login  或设置 CURSOR_API_KEY
# CURSOR_API_KEY=
CURSOR_AGENT_CWD=/Users/weiweiwang/testcode/nautilus_ibkr_helloworld
CURSOR_AGENT_MODE=ask
# CURSOR_AGENT_MODEL=auto
# CURSOR_AGENT_FORCE=false
# CURSOR_AGENT_TIMEOUT_SEC=300

# 项目路径
NAUTILUS_ROOT=/Users/weiweiwang/testcode/nautilus_ibkr_helloworld
NAUTILUS_API_BASE=http://localhost:3000

# Alpha 扫描标的（不含 QQQ、SPY）
ALPHA_SYMBOLS=NVDA,TSLA,AAPL
# 建议交易有效期（reclaim 窗口，默认 30 分钟）
# ALPHA_PROPOSAL_TTL_SECONDS=1800
# 建议在 Redis 中的保留时长（页面/审批可见，默认 8 小时；与引擎重启无关）
# PROPOSAL_REDIS_RETENTION_SECONDS=28800

# Legacy alpha daemon（0=关，用 Cursor MCP；1=启动 python alpha_agent.py）
# ALPHA_USE_DAEMON=0

# ── 超级信号 (st_super) ─────────────────────────────────────────────────────
# 仅超级信号；回踩类（VWAP/ST/DEMA20 触线）已从检测/扫描/建单全链路禁用
# ALPHA_PRIMARY_SIGNAL 保留兼容，实际固定为 st_super
ALPHA_PRIMARY_SIGNAL=st_super
# 禁用 legacy st_dema_m5 / 开盘突破 bypass（1=仅审批路径）
ALPHA_SUPER_ONLY=1
# ST 参数（与 strategy.py / multi.html 一致）
ST_SUPER_PERIOD=10
ST_SUPER_MULT_1M=3.0
ST_SUPER_MULT_5M=3.5
ST_SUPER_TP_RR=2.0
# 实时 st_super 触线后引擎内直接建 pending 建议（1=开，0=仅写 touch 靠 MCP 扫描）
ALPHA_AUTO_PROPOSAL=1

# ── AutoRunner 执行 ─────────────────────────────────────────────────────────
# 固定手数；0=按 R 风控 sizing（推荐）
AUTO_FIXED_QTY=0
# live 模式下 fixed_qty>0 需显式 ALLOW_FIXED_QTY=1（否则引擎拒绝启动）
# ALLOW_FIXED_QTY=1
# AUTO_STRATEGY_MODE=live   # live | observe

# ── 安全 / 前端 API ─────────────────────────────────────────────────────────
# paper=禁止自动实盘报单（默认）；live=允许 Agent 向 IBKR 提交订单
TRADING_ENV=paper

# 延迟行情：AutoPM / order_actor 平仓均改用 marketable LIMIT（防 IBKR 10349 拒 MARKET）
# 与 main.py MARKET_DATA_TYPE 共用此开关（二选一即可）：
# MARKET_DATA_DELAYED=1
# MARKET_DATA_MODE=delayed_frozen   # realtime | delayed | delayed_frozen

# 信号 outcome SQLite（默认 .run/signals.db）
# SIGNAL_DB_PATH=.run/signals.db
# 前端 :3000 绑定地址（默认仅本机）
NAUTILUS_BIND_HOST=127.0.0.1
# 审批/下单 API 密钥（前端首次操作会 prompt，CLI 用 X-Nautilus-Token）
NAUTILUS_API_SECRET=
# 引擎下单网关密钥（server.js → order_actor :8888；live 强烈建议必填）
ORDER_GATEWAY_SECRET=
# 飞书 webhook 强制校验 Token（设 NAUTILUS_API_SECRET 时默认开启）
# FEISHU_REQUIRE_TOKEN=1

# 入场窗口 blackout（与 st_super / RiskGate 一致，分钟）
# RTH_OPEN_BLACKOUT_MIN=15
# RTH_PRE_EOD_BLACKOUT_MIN=30
# 执行 claim TTL（秒，默认 600）
# PROPOSAL_EXEC_CLAIM_TTL_SECONDS=600
